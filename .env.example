# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Which data layer the app talks to: "local" (localStorage, no backend) or "supabase".
VITE_DATA_BACKEND=local

# Supabase — Settings -> API in the dashboard.
# The anon key is public by design: it ships in the client bundle and RLS is the
# actual security boundary. Safe to expose.
VITE_SUPABASE_URL=https://ktitknextfavmcixyfak.supabase.co
VITE_SUPABASE_ANON_KEY=

# SECRET. Used only by the seed script (scripts/seed.mjs), never by the app.
# Bypasses RLS entirely. Never prefix with VITE_ (that would ship it to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Instrumentation (Phase 6) — PostHog covers both product analytics and error
# tracking. No-op when empty.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
